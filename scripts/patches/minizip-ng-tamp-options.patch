+        /* Tamp: "./-name" keeps a leading dash from reading as an option; store it as "-name". */
+        while (filenameinzip[0] == '.' && filenameinzip[1] == '/')
+            filenameinzip += 2;
+
+        if (writer->skip_macos_junk && mz_zip_writer_is_macos_junk(path))
+            return err;
+
         if (*filenameinzip != 0)
             err = mz_zip_writer_add_file(writer, path, filenameinzip);
 
@@ -1946,6 +1961,13 @@
     writer->store_links = store_links;
 }
 
+void mz_zip_writer_set_skip_macos_junk(void *handle, uint8_t skip_macos_junk) {
+    mz_zip_writer *writer = (mz_zip_writer *)handle;
+    if (!writer)
+        return;
+    writer->skip_macos_junk = skip_macos_junk;
+}
