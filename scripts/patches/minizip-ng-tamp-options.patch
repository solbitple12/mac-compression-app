+/* Tamp: Finder's .DS_Store files, AppleDouble "._" files and __MACOSX folders. */
+static int32_t mz_zip_writer_is_macos_junk(const char *path) {
+    const char *name = strrchr(path, '/');
+    name = name ? name + 1 : path;
+    return strcmp(name, ".DS_Store") == 0 || strncmp(name, "._", 2) == 0 || strcmp(name, "__MACOSX") == 0;
+}
+
 int32_t mz_zip_writer_add_path(void *handle, const char *path, const char *root_path, uint8_t include_path,
                                uint8_t recursive) {
