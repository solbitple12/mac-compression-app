+// Tamp: extraction never writes outside the -to folder, so ".." components
+// are dropped from stored names ("../x" becomes "x", "a/../b" becomes "a/b").
+static string drop_parent_dirs(const string& name) {
+  string out;
+  size_t start=0;
+  for (;;) {
+    size_t end=name.find('/', start);
+    const bool last=(end==string::npos);
+    if (last) end=name.size();
+    const string part=name.substr(start, end-start);
+    if (part!="..") {
+      out+=part;
+      if (!last) out+='/';
+    }
+    if (last) break;
+    start=end+1;
+  }
+  return out;
+}
